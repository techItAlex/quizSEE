{
  "manifest_version": 3,
  "name": "quizSEE",
  "version": "1.0.0",
  "description": "Transparent quiz-behavior monitoring for Google Forms quizzes.",
  "key": "",
  "permissions": ["identity", "storage", "alarms"],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "action": { "default_popup": "popup/popup.html", "default_title": "quizSEE" },
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["lib/selectors.js", "content/forms-monitor.js"],
      "css": ["content/banner.css"],
      "run_at": "document_idle"
    }
  ]
}
